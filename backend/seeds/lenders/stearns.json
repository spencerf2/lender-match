  "notes": [
    {
      "kind": "unmapped",
      "text": "Comp Debt: Any single open account equal to or greater than requested amount; Any single closed account within last 12 months equal to or greater than requested amount; 3 or more contracts ($10K minimum) with payment activity in the last 12 months"
    },
    {
      "kind": "unmapped",
      "text": "Revolver Utilization: Personal revolving over $30K OR revolving + unsecured debt over $50K (excluding student loans)"
    },
    {
      "kind": "unmapped",
      "text": "Restriction: Foreign Country. No field says where the business is domiciled beyond its US state."
    },
    {
      "kind": "unmapped",
      "text": "Restriction: No Physical Location. No field for a physical location."
    },
    {
      "kind": "informational",
      "text": "Restriction: OTR. The industry list has a single trucking value, so the criterion excludes all trucking, not only over-the-road."
    },
    {
      "kind": "informational",
      "text": "These are only guidelines and are subject to lender discretion."
    },
    {
      "kind": "informational",
      "text": "SUBJECT TO CREDIT APPROVAL/QUALIFICATIONS. SOME LIMITATIONS MAY APPLY. TERMS, CONDITIONS, APPLICABLE TAX, SHIPPING, INSURANCE AND CLOSING COSTS MAY APPLY. SUBJECT TO CHANGE WITHOUT NOTICE. MEMBER FDIC."
    }
  ]
